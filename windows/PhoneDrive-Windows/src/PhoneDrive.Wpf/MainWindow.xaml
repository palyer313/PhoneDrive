<Window Icon="pack://application:,,,/Assets/PhoneDrive.ico" x:Class="PhoneDrive.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PhoneDrive.Wpf.Views"
        Title="PhoneDrive · 双栏文件管理器"
        Width="1320" Height="820" MinWidth="1180" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource App.Background}"
        Foreground="{DynamicResource App.Text}"
        Loaded="Window_Loaded" Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource App.Toolbar}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Menu Background="Transparent" Padding="3,2">
                    <MenuItem Header="左侧(_L)">
                        <MenuItem Header="新建标签页" Command="{Binding LeftPane.NewTabCommand}"/>
                        <MenuItem Header="刷新" Command="{Binding LeftPane.ActiveTab.RefreshCommand}"/>
                        <MenuItem Header="上级目录" Command="{Binding LeftPane.ActiveTab.UpCommand}"/>
                    </MenuItem>
                    <MenuItem Header="标记(_M)">
                        <MenuItem Header="全选" Click="SelectAll_Click" InputGestureText="Ctrl+A"/>
                        <MenuItem Header="取消选择" Click="ClearSelection_Click"/>
                    </MenuItem>
                    <MenuItem Header="文件(_F)">
                        <MenuItem Header="打开" Command="{Binding ActivePane.ActiveTab.OpenCommand}" InputGestureText="Enter"/>
                        <MenuItem Header="复制到另一侧" Command="{Binding CopyCommand}" InputGestureText="F5"/>
                        <MenuItem Header="移动到另一侧" Command="{Binding MoveCommand}" InputGestureText="F6"/>
                        <MenuItem Header="删除" Command="{Binding DeleteCommand}" InputGestureText="F8"/>
                        <Separator/>
                        <MenuItem Header="退出" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem Header="命令(_C)">
                        <MenuItem Header="新建文件夹" Command="{Binding NewFolderCommand}" InputGestureText="F7"/>
                        <MenuItem Header="重命名" Command="{Binding ActivePane.ActiveTab.RenameCommand}" InputGestureText="F2"/>
                        <MenuItem Header="单向同步到另一侧…" Command="{Binding SyncCommand}"/>
                    </MenuItem>
                    <MenuItem Header="标签页(_T)">
                        <MenuItem Header="新建标签页" Command="{Binding ActivePane.NewTabCommand}"/>
                        <MenuItem Header="关闭当前标签页" Command="{Binding ActivePane.CloseTabCommand}" CommandParameter="{Binding ActivePane.ActiveTab}"/>
                    </MenuItem>
                    <MenuItem Header="选项(_O)">
                        <MenuItem Header="设备管理" Click="DeviceManager_Click"/>
                        <MenuItem Header="显示传输队列" IsCheckable="True" IsChecked="{Binding IsTransferPanelVisible, Mode=TwoWay}"/>
                        <MenuItem Header="显示隐藏文件" IsCheckable="True" IsChecked="{Binding ActivePane.ActiveTab.ShowHidden, Mode=TwoWay}"/>
                        <MenuItem Header="设置" Click="Settings_Click"/>
                    </MenuItem>
                    <MenuItem Header="右侧(_R)">
                        <MenuItem Header="新建标签页" Command="{Binding RightPane.NewTabCommand}"/>
                        <MenuItem Header="刷新" Command="{Binding RightPane.ActiveTab.RefreshCommand}"/>
                        <MenuItem Header="上级目录" Command="{Binding RightPane.ActiveTab.UpCommand}"/>
                    </MenuItem>
                    <MenuItem Header="帮助(_H)"><MenuItem Header="关于 PhoneDrive" Click="About_Click"/></MenuItem>
                </Menu>
                <DockPanel Margin="5,2,5,5">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock Text="PhoneDrive" FontWeight="SemiBold" Foreground="{DynamicResource App.Accent}" VerticalAlignment="Center" Margin="4,0,15,0"/>
                        <Button Content="设备管理" Style="{StaticResource ToolbarButton}" Click="DeviceManager_Click"/>
                        <Button Content="传输队列" Style="{StaticResource ToolbarButton}" Click="TransferPanel_Click"/>
                        <Button Content="设置" Style="{StaticResource ToolbarButton}" Click="Settings_Click"/>
                        <Button Content="刷新" Style="{StaticResource ToolbarButton}" Click="RefreshActivePane_Click" ToolTip="刷新活动窗格"/>
                    </StackPanel>
                    <TextBlock Text="{Binding DeviceSummary}" Foreground="{DynamicResource App.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,5,0"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 双栏 -->
        <Grid Grid.Row="1" Margin="3,3,3,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="RightColumn" Width="*"/>
            </Grid.ColumnDefinitions>

            <views:PaneView x:Name="LeftPaneView" Grid.Column="0" DataContext="{Binding LeftPane}"/>
            <GridSplitter Grid.Column="1" Width="5" MouseDoubleClick="Splitter_DoubleClick" ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource App.Border}" ShowsPreview="False"/>
            <views:PaneView x:Name="RightPaneView" Grid.Column="2" DataContext="{Binding RightPane}"/>
        </Grid>

        <!-- 操作栏 -->
        <Border Grid.Row="2" Background="{DynamicResource App.Panel}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0"
                Padding="6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="复制 (F5)" Command="{Binding CopyCommand}" Margin="0,0,6,0"/>
                    <Button Content="移动 (F6)" Command="{Binding MoveCommand}" Margin="0,0,6,0"/>
                    <Button Content="删除 (F8)" Command="{Binding DeleteCommand}" Margin="0,0,6,0"/>
                    <Button Content="同步" Command="{Binding SyncCommand}" Margin="0,0,6,0"/>
                    <Button Content="新建文件夹 (F7)" Command="{Binding NewFolderCommand}" Margin="0,0,6,0"/>
                    <CheckBox Content="显示隐藏文件 (Ctrl+H)" Margin="8,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding ActivePane.ActiveTab.ShowHidden, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="活动窗格：" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActivePaneName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="刷新活动窗格" Margin="12,0,0,0" Click="RefreshActivePane_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 传输队列 / 历史 -->
        <Border Grid.Row="3" Background="{DynamicResource App.TransferPanel}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0"
                Visibility="{Binding IsTransferPanelVisible, Converter={StaticResource BoolToVis}}">
            <Grid Margin="8,6,8,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="传输队列" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Transfers.Summary}" Style="{StaticResource MutedText}"
                                   Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="显示历史" IsChecked="{Binding Transfers.ShowHistory, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="暂停" Command="{Binding Transfers.PauseCommand}" Margin="0,0,4,0" Padding="8,3"/>
                        <Button Content="恢复" Command="{Binding Transfers.ResumeCommand}" Margin="0,0,4,0" Padding="8,3"/>
                        <Button Content="取消" Command="{Binding Transfers.CancelCommand}" Margin="0,0,4,0" Padding="8,3"/>
                        <Button Content="重试" Command="{Binding Transfers.RetryCommand}" Margin="0,0,4,0" Padding="8,3"/>
                        <Button Content="清空已完成" Command="{Binding Transfers.ClearCompletedCommand}" Padding="8,3"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                        CornerRadius="4" Margin="0,6,0,0">
                    <ListView ItemsSource="{Binding Transfers.View}"
                              SelectedItem="{Binding Transfers.SelectedRow, Mode=TwoWay}"
                              Height="150" BorderThickness="0">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
                                <GridViewColumn Header="任务名" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="源" Width="170" DisplayMemberBinding="{Binding SourceDisplay}"/>
                                <GridViewColumn Header="目标" Width="170" DisplayMemberBinding="{Binding TargetDisplay}"/>
                                <GridViewColumn Header="大小" Width="70" DisplayMemberBinding="{Binding SizeDisplay}"/>
                                <GridViewColumn Header="已传" Width="70" DisplayMemberBinding="{Binding TransferredDisplay}"/>
                                <GridViewColumn Header="速度" Width="72" DisplayMemberBinding="{Binding SpeedDisplay}"/>
                                <GridViewColumn Header="剩余" Width="58" DisplayMemberBinding="{Binding EtaDisplay}"/>
                                <GridViewColumn Header="进度" Width="86">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="状态" Width="66" DisplayMemberBinding="{Binding StateText}"/>
                                <GridViewColumn Header="错误" Width="180" DisplayMemberBinding="{Binding Error}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="4" Background="{DynamicResource App.PanelAlt}"
                BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                           Text="F5 复制   F6 移动   F7 新建   F8 删除"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
