<UserControl x:Class="PhoneDrive.Wpf.Views.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Focusable="True" Background="Transparent">
    <Border x:Name="PaneBorder" Margin="1" CornerRadius="0" BorderThickness="1"
            Background="{DynamicResource App.Panel}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource App.Border}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource App.Toolbar}"/>

            <!-- 标签页条 -->
            <Grid Grid.Row="0" Margin="3,3,3,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabBorder" CornerRadius="0" Margin="0,0,3,0"
                                        Background="{DynamicResource App.PanelAlt}"
                                        BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Title}" FontSize="12" Padding="7,4"
                                                Style="{StaticResource IconButton}"
                                                Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding CurrentPath}"/>
                                        <Button Content="✕" FontSize="9" Padding="4,2"
                                                Style="{StaticResource IconButton}"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="关闭标签页"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource App.Selection}"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="1" Content="＋" FontSize="13" Padding="8,3" Margin="4,0,0,0"
                        Style="{StaticResource IconButton}" Command="{Binding NewTabCommand}"
                        ToolTip="新建标签页"/>
            </Grid>

            <!-- Independent source and navigation toolbar -->
            <DockPanel Grid.Row="1" Margin="3,4,3,3" LastChildFill="False">
                <ComboBox Width="200" ItemsSource="{Binding Sources}"
                          SelectedItem="{Binding ActiveTab.SelectedSource, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" ToolTip="选择本地磁盘或已配对设备"/>
                <Button Content="←" Width="29" Margin="5,0,0,0" Style="{StaticResource IconButton}" Command="{Binding ActiveTab.BackCommand}" ToolTip="后退"/>
                <Button Content="→" Width="29" Style="{StaticResource IconButton}" Command="{Binding ActiveTab.ForwardCommand}" ToolTip="前进"/>
                <Button Content="↑" Width="29" Style="{StaticResource IconButton}" Command="{Binding ActiveTab.UpCommand}" ToolTip="上级目录"/>
                <Button Content="⟳" Width="29" Style="{StaticResource IconButton}" Command="{Binding ActiveTab.RefreshCommand}" ToolTip="刷新"/>
                <Button Content="☆ 收藏" Padding="6,2" Style="{StaticResource IconButton}" Command="{Binding AddFavoriteCommand}"/>
            </DockPanel>

            <DockPanel Grid.Row="2" Margin="3,0,3,3">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Command="{Binding ActiveTab.CopyToOtherCommand}" ToolTip="复制到另一侧 F5"><StackPanel Orientation="Horizontal"><Image Width="16" Height="16" Margin="0,0,3,0" Source="{StaticResource Command.Copy}"/><TextBlock Text="复制" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ActiveTab.MoveToOtherCommand}" ToolTip="移动到另一侧 F6"><StackPanel Orientation="Horizontal"><Image Width="16" Height="16" Margin="0,0,3,0" Source="{StaticResource Command.Move}"/><TextBlock Text="移动" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ActiveTab.RenameCommand}" ToolTip="F2"><StackPanel Orientation="Horizontal"><Image Width="16" Height="16" Margin="0,0,3,0" Source="{StaticResource Command.Rename}"/><TextBlock Text="重命名" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ActiveTab.NewFolderCommand}" ToolTip="新建文件夹 F7"><StackPanel Orientation="Horizontal"><Image Width="16" Height="16" Margin="0,0,3,0" Source="{StaticResource Command.New}"/><TextBlock Text="新建" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button Style="{StaticResource IconButton}" Command="{Binding ActiveTab.PropertiesCommand}"><StackPanel Orientation="Horizontal"><Image Width="16" Height="16" Margin="0,0,3,0" Source="{StaticResource Command.Properties}"/><TextBlock Text="属性" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <TextBox x:Name="FilterBox" DockPanel.Dock="Right" Width="88" Height="25" Margin="4,0,0,0"
                         Text="{Binding ActiveTab.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="筛选当前列表"/>
                <Button DockPanel.Dock="Right" Content="清除" Style="{StaticResource IconButton}" Command="{Binding ActiveTab.ClearSearchCommand}"/>
                <Button DockPanel.Dock="Right" Content="查找" Style="{StaticResource IconButton}" Command="{Binding ActiveTab.SearchCommand}"/>
                <TextBox x:Name="SearchBox" Height="25" MinWidth="40" Margin="5,0,0,0"
                         Text="{Binding ActiveTab.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchBox_KeyDown" ToolTip="搜索当前目录及子目录，回车执行"/>
            </DockPanel>

            <Border Grid.Row="3" BorderThickness="0,1" BorderBrush="{DynamicResource App.Border}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource App.PanelAlt}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource App.Selection}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBox x:Name="PathBox" Height="25" BorderThickness="0" Background="Transparent" Padding="5,2"
                         Text="{Binding ActiveTab.CurrentPath, Mode=OneWay}" KeyDown="PathBox_KeyDown"
                         ToolTip="当前路径；输入后回车跳转（Ctrl+L）"/>
            </Border>

            <!-- 文件列表 -->
            <Border Grid.Row="4" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0">
                <ListView x:Name="FileList" AllowDrop="True"
                          DataContext="{Binding ActiveTab}" ItemsSource="{Binding Entries}"
                          SelectionMode="Extended" BorderThickness="0" FontSize="12"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          SelectionChanged="FileList_SelectionChanged"
                          MouseDoubleClick="FileList_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                          PreviewMouseRightButtonDown="FileList_PreviewMouseRightButtonDown"
                          MouseMove="FileList_MouseMove"
                          DragOver="FileList_DragOver" Drop="FileList_Drop"
                          KeyDown="FileList_KeyDown">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ColumnHeaderStyle}">
                            <GridViewColumn Header="名称" Width="245">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="大小" Width="82">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplaySize}" HorizontalAlignment="Right"
                                                   Margin="0,0,6,0"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="类型" Width="95" DisplayMemberBinding="{Binding DisplayType}"/>
                            <GridViewColumn Header="已改变" Width="145" DisplayMemberBinding="{Binding DisplayModified}"/>
                        </GridView>
                    </ListView.View>

                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="打开" Command="{Binding OpenCommand}"/>
                            <MenuItem Header="复制到另一窗格  (F5)" Command="{Binding CopyToOtherCommand}"/>
                            <MenuItem Header="剪切到另一窗格  (F6)" Command="{Binding MoveToOtherCommand}"/>
                            <MenuItem Header="重命名  (F2)" Command="{Binding RenameCommand}"/>
                            <MenuItem Header="新建文件夹  (F7)" Command="{Binding NewFolderCommand}"/>
                            <MenuItem Header="删除  (Del)" Command="{Binding DeleteCommand}"/>
                            <MenuItem Header="属性" Command="{Binding PropertiesCommand}"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
            </Border>

            <!-- 收藏目录 -->
            <DockPanel Grid.Row="5" Margin="6,5,6,3">
                <TextBlock DockPanel.Dock="Left" Text="收藏" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Favorites}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource App.PanelAlt}"
                                        BorderBrush="{DynamicResource App.Border}" BorderThickness="1"
                                        CornerRadius="10" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding DisplayName}" FontSize="11" Padding="8,3"
                                                Style="{StaticResource IconButton}"
                                                Command="{Binding DataContext.BrowseFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="{Binding Path}"/>
                                        <Button Content="✕" FontSize="8" Padding="4,2"
                                                Style="{StaticResource IconButton}"
                                                Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="移除收藏"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- 状态栏 -->
            <Border Grid.Row="6" Background="{DynamicResource App.PanelAlt}"
                    BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0" Padding="8,3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveTab.StatusMessage}"
                               Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding ActiveTab.SelectionSummary}"
                               Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
