<Window Icon="pack://application:,,,/Assets/PhoneDrive.ico" x:Class="PhoneDrive.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="600" Height="790" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Title="设置 · PhoneDrive"
        Background="{DynamicResource App.Background}" Foreground="{DynamicResource App.Text}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="主题" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1">
                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding ThemeChoice, Mode=TwoWay}" Width="200" HorizontalAlignment="Left"/>
                <TextBlock Text="主题色 · 选择预设或自定义" Margin="0,10,0,6"/>
                <WrapPanel>
                    <Button Content="海蓝" Tag="#1565C0" Click="Preset_Click"/>
                    <Button Content="翡翠" Tag="#008577" Click="Preset_Click"/>
                    <Button Content="紫罗兰" Tag="#7C4DFF" Click="Preset_Click"/>
                    <Button Content="玫瑰" Tag="#C2185B" Click="Preset_Click"/>
                    <Button Content="琥珀" Tag="#C77700" Click="Preset_Click"/>
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Width="30" Height="30" Background="{Binding AccentColor}" BorderBrush="Gray" BorderThickness="1" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" Width="100" MaxLength="7"/>
                    <Button Content="颜色盘…" Click="PickColor_Click" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="并发传输数" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ComboBox ItemsSource="{Binding ConcurrencyOptions}"
                          SelectedItem="{Binding Concurrency, Mode=TwoWay}" Width="90"/>
                <TextBlock Text="（每个任务使用独立设备会话）" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="2" Text="系统集成" Style="{StaticResource SectionTitle}" Margin="0,20,0,6"/>
        <Border Grid.Row="3" Background="{DynamicResource App.PanelAlt}" BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1" CornerRadius="4" Padding="12,10">
            <StackPanel>
                <CheckBox Content="开机启动（仅写入当前用户注册表，无需管理员权限）"
                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,0,0,8"/>
                <CheckBox Content="关闭主窗口时最小化到托盘（取消勾选则关闭直接退出）"
                          IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Margin="0,0,0,8"/>
                <CheckBox Content="启动时自动连接已配对设备（身份冲突设备除外）"
                          IsChecked="{Binding AutoConnectOnStartup, Mode=TwoWay}" Margin="0,0,0,8"/>
                <CheckBox Content="连接成功后自动挂载盘符（第一台 X:、第二台 Y:，可随时修改）"
                          IsChecked="{Binding AutoMountOnStartup, Mode=TwoWay}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" Text="存储位置与依赖" Style="{StaticResource SectionTitle}" Margin="0,20,0,6"/>
        <Border Grid.Row="5" Background="{DynamicResource App.PanelAlt}" BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1" CornerRadius="4" Padding="10">
            <StackPanel>
                <TextBlock Text="手机分享接收文件夹" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="ReceiveFolder" Text="{Binding ReceiveFolder, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                <WrapPanel Margin="0,6,0,12">
                    <Button Content="选择文件夹…" Click="ReceiveFolder_Click"/>
                    <Button Content="恢复系统下载目录" Click="DefaultReceiveFolder_Click" Margin="8,0,0,0"/>
                </WrapPanel>
                <TextBlock Text="{Binding StorageInfo}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding DependencyInfo}" TextWrapping="Wrap" Style="{StaticResource MutedText}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="88" Margin="0,0,8,0" Command="{Binding CancelCommand}"/>
            <Button Content="保存" Width="88" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
