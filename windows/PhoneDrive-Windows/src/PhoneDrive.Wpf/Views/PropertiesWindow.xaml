<Window Icon="pack://application:,,,/Assets/PhoneDrive.ico" x:Class="PhoneDrive.Wpf.Views.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="380" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Title="属性"
        Background="{DynamicResource App.Panel}" Foreground="{DynamicResource App.Text}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Margin="0,6" Foreground="{DynamicResource App.TextMuted}"/>
            <TextBlock x:Name="NameText" Grid.Row="0" Grid.Column="1" Margin="0,6" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="路径" Margin="0,6" Foreground="{DynamicResource App.TextMuted}"/>
            <TextBlock x:Name="PathText" Grid.Row="1" Grid.Column="1" Margin="0,6" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="大小" Margin="0,6" Foreground="{DynamicResource App.TextMuted}"/>
            <TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="1" Margin="0,6"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="修改时间" Margin="0,6" Foreground="{DynamicResource App.TextMuted}"/>
            <TextBlock x:Name="ModifiedText" Grid.Row="3" Grid.Column="1" Margin="0,6"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="类型" Margin="0,6" Foreground="{DynamicResource App.TextMuted}"/>
            <TextBlock x:Name="TypeText" Grid.Row="4" Grid.Column="1" Margin="0,6"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="符号链接" Margin="0,6" Foreground="{DynamicResource App.TextMuted}"/>
            <TextBlock x:Name="SymlinkText" Grid.Row="5" Grid.Column="1" Margin="0,6"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="隐藏" Margin="0,6" Foreground="{DynamicResource App.TextMuted}"/>
            <TextBlock x:Name="HiddenText" Grid.Row="6" Grid.Column="1" Margin="0,6"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="来源" Margin="0,6" Foreground="{DynamicResource App.TextMuted}"/>
            <TextBlock x:Name="SourceText" Grid.Row="7" Grid.Column="1" Margin="0,6" TextWrapping="Wrap"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyPathButton" Content="复制路径" Width="96" Margin="0,0,8,0" Click="CopyPath_Click"/>
            <Button Content="关闭" Width="88" Style="{StaticResource AccentButton}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
