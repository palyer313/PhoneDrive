<Window Icon="pack://application:,,,/Assets/PhoneDrive.ico" x:Class="PhoneDrive.Wpf.Views.PairInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="配对设备 · PhoneDrive"
        Background="{DynamicResource App.Background}" Foreground="{DynamicResource App.Text}">
    <StackPanel Margin="18">
        <TextBlock Text="输入对端显示的 IP、端口与 6 位配对码" FontWeight="SemiBold"/>
        <TextBlock Text="配对成功后本机会保存对端的 Host Key 指纹，后续连接强制校验该指纹。"
                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"/>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="56"/>
                <ColumnDefinition Width="96"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP 地址" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="IpBox" Height="30" Margin="0,0,10,10"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="端口" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="PortBox" Text="47821" Height="30" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="配对码" VerticalAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CodeBox" Height="30"
                     MaxLength="6" FontFamily="Consolas" FontSize="16"/>
        </Grid>

        <Border Background="{DynamicResource App.PanelAlt}" BorderBrush="{DynamicResource App.Border}"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="对端设备" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="DeviceText" Text="—" Style="{StaticResource MutedText}" Margin="0,4,0,6"/>
                <TextBlock Text="Host Key 指纹（须与对端设备屏幕逐字核对）" Style="{StaticResource SectionTitle}"/>
                <TextBox x:Name="FingerprintText" FontFamily="Consolas" Margin="0,4,0,0" ToolTip="粘贴对端屏幕或二维码中的完整 SHA256 指纹"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Text="" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource App.Danger}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="88" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button x:Name="PairButton" Content="已核对，配对" Width="118"
                    Style="{StaticResource AccentButton}" Click="Pair_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
